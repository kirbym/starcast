# Claude API key used to generate the Cosmic Report narration
ANTHROPIC_API_KEY=

# Frontend origin allowed to call the backend API (CORS)
CORS_ORIGIN=http://localhost:5173

# Backend base URL the frontend calls
VITE_API_BASE_URL=http://localhost:8000

# Optional: writable directory for the ephemeris and comet elements downloads
# (default: backend/.cache/skyfield)
# STARCAST_DATA_DIR=

# Optional: an MPC comet elements file to use instead of downloading AllCometEls.txt
# STARCAST_COMET_ELEMENTS=
